// Cloudflare Workers Builds / wrangler configuration for the Studia Worker (no secret here).
// Secrets (TIKTOK_CLIENT_KEY, TIKTOK_CLIENT_SECRET, SESSION_KEY) are set once in the Cloudflare dashboard.
// Direct Post mode (audit demo and, once approved, real posting). Back to inbox drafts: POST_MODE "draft" and
// SCOPES "user.info.basic,video.upload,video.list" (then log in again).
{
  "name": "tiktok",
  "main": "studia-worker.mjs",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "keep_vars": true,
  "vars": {
    "POST_MODE": "direct",
    "SCOPES": "user.info.basic,video.publish,video.list"
  }
}
