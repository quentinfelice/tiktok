// Cloudflare Workers Builds / wrangler configuration for the Studia Worker (no secret here).
// Secrets (TIKTOK_CLIENT_KEY, TIKTOK_CLIENT_SECRET, SESSION_KEY) are set once in the Cloudflare dashboard.
// Inbox drafts: the operating mode while the Direct Post audit is on HOLD (AUDIT_PACK.md). Direct Post would be
// POST_MODE "direct" and SCOPES "user.info.basic,video.publish,video.list" (then log in again), plus the SentLock
// Durable Object (one record per posted item, shared by every browser; SQLite-backed, available on the Free plan):
//   "durable_objects": { "bindings": [{ "name": "SENT_LOCK", "class_name": "SentLock" }] },
//   "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SentLock"] }]
// Without it, direct posts are refused (server_not_configured).
{
  "name": "tiktok",
  "main": "studia-worker.mjs",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "keep_vars": true,
  "vars": {
    "POST_MODE": "draft",
    "SCOPES": "user.info.basic,video.upload,video.list"
  }
}
